<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.List,org.lifelink.model.Donor" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Search Results | LifeLink</title><link rel="stylesheet" href="css/style.css"></head><body><%@ include file="partials/nav.jspf" %>
<main class="page wrap"><div class="page-heading"><span class="eyebrow">SEARCH RESULTS</span><h1>Potential donor <em>matches.</em></h1><p>Results are generated by the Java DonorService using demonstration records.</p></div>
<div class="demo-alert">All profiles are fictional demo data. No real donor is registered in this prototype.</div>
<div class="donor-grid"><% List<Donor> donors=(List<Donor>)request.getAttribute("donors"); if(donors!=null && !donors.isEmpty()){ for(Donor d:donors){ %>
<article class="donor-card"><div class="blood-badge"><%= d.getBloodGroup() %></div><div><b><%= d.getName() %></b><small><%= d.getDistrict() %> District · Available in demo data</small></div><span class="sample-tag">DEMO</span></article>
<% }} else { %><p class="empty-state">No available sample profile matches these filters.</p><% } %></div>
<a class="btn outline" href="find-blood.jsp">← Back to search</a>
<div class="safety-box"><b>Medical safety</b><p>This filter is not a clinical compatibility test. Qualified professionals must verify eligibility, grouping, screening and crossmatching.</p></div></main><footer><div class="wrap footer-inner"><b>Life<span>Link</span></b><small>Student project prototype</small></div></footer></body></html>
